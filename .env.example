# =============================================================================
# AIBA — environment configuration
#
# Copy to `.env` and edit. Nothing in this file is a real credential; every
# value below is either a placeholder or a safe local default.
#
#   cp .env.example .env
#   npm run db:setup      # migrate + seed (plans, agents, sources, admin)
#   npm run dev           # web
#   npm run worker        # queue worker   (second terminal / container)
#   npm run scheduler     # cron scheduler (second terminal / container)
#
# Required variables are marked [REQUIRED]. Everything else is optional: AIBA
# starts and runs its full loop with no third-party credentials — features that
# need one report themselves as "not configured" rather than failing.
#
# Never commit your real .env. Secrets belong in the server environment or your
# host's secret store, and are never sent to the browser.
# =============================================================================

# ----------------------------------------------------------------- core [REQUIRED]
# Public origin of the deployment. Used for links, cookies and checkout returns.
APP_URL=http://localhost:3000
APP_NAME=AIBA
NODE_ENV=development

# Signs session cookies and auth tokens. [REQUIRED in production]
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Session lifetime in hours (default 14 days).
SESSION_TTL_HOURS=336

# Allow self-service registration. With `false`, only an existing account can
# create the first user (useful for private deployments).
ALLOW_REGISTRATION=true

# Require an email link before a new account can sign in.
# Needs a working EMAIL_PROVIDER (see below).
REQUIRE_EMAIL_VERIFICATION=false

# Set `true` when serving over HTTPS: adds the __Host- cookie prefix. [REQUIRED true in production]
# It is also detected per request from `x-forwarded-proto`, so a TLS-terminating
# proxy still gets Secure cookies.
COOKIE_SECURE=false

# Cross-site cookie policy: lax | strict | none.
#   lax    (default) normal first-party use.
#   strict           never send the session cookie on navigation from another site.
#   none             needed when the app is embedded in a frame on another origin
#                    (hosted previews, white-label consoles). Browsers accept
#                    `none` only together with Secure, which is forced for you.
#                    Sign-in silently fails inside a cross-site frame while this is
#                    `lax`, because the browser discards the session cookie.
COOKIE_SAMESITE=lax

# Allow the app to be framed (drops X-Frame-Options, sets a frame-ancestors
# allow-list). Set true only for deployments that are legitimately embedded, and
# pair it with COOKIE_SAMESITE=none.
ALLOW_EMBED=false
# Space-separated ancestors allowed when ALLOW_EMBED=true.
FRAME_ANCESTORS='self' https://*.e2b.app https://*.arena.ai

# ----------------------------------------------------------------- database
# postgres:// URL for PostgreSQL, or `pglite://<dir>` for the embedded engine
# (single node, zero external services — what the quick start uses).
DATABASE_URL=pglite://./data/pgdata
# DATABASE_URL=postgres://aiba:change-me@localhost:5432/aiba
DB_POOL_MAX=10
DB_SSL=false

# --------------------------------------------------------------------- queue
# redis:// URL, or `memory` for the in-process driver (single node only).
# With Redis, jobs survive a restart and several workers can share the queue.
REDIS_URL=memory
# REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=aiba
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1500
WORKER_ID=
# Run jobs inline in the web process (handy locally, not for production).
# With the embedded pglite:// driver this is the *only* safe multi-job mode: the
# worker and scheduler processes refuse to start because a second process would
# see stale data (see docs/DEPLOYMENT.md).
ENABLE_INLINE_JOBS=true
# Escape hatch for throwaway experiments only — never in production:
# ALLOW_PGLITE_MULTI_PROCESS=true
JOB_DEFAULT_TIMEOUT_MS=120000
JOB_MAX_ATTEMPTS=3

# ----------------------------------------------------------------- scheduler
# `false` locally (run `npm run scheduler` instead); `true` in the scheduler
# container so exactly one process evaluates cron entries.
ENABLE_SCHEDULER=false
SCHEDULER_TICK_MS=20000
SCHEDULER_LEADER_LOCK_MS=45000

# ------------------------------------------------------------------------ AI
# auto | openai | anthropic | openrouter | ollama | custom | none
# `none` is fully supported: agents fall back to deterministic logic and no
# model call is ever made, so nothing is billed.
AI_PROVIDER=auto
# AI_PROVIDER_KEY=                      # generic key when using `custom`
# AI_BASE_URL=http://localhost:11434/v1 # required for `custom` / `ollama`
AI_CHAT_MODEL=gpt-4o-mini
AI_REASONING_MODEL=gpt-4o
AI_CHEAP_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=0.3
# Allow outbound calls to the model provider at all.
AI_ALLOW_NETWORK=true

# Provider keys — set the one matching your provider, and only that one.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------ payments
# stripe | demo | none
# `demo` exists for local testing of the checkout flow and can never charge.
# `none` is valid: plans, limits and the workspace all work without billing.
PAYMENT_PROVIDER=none
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # required to verify webhooks
# PAYMENT_PROVIDER_KEY=                 # generic key for non-Stripe providers
# PAYMENT_SUCCESS_URL=
# PAYMENT_CANCEL_URL=

# --------------------------------------------------------------------- email
# smtp | resend | console | file
# `console` prints messages to the log; `file` writes .eml files to
# EMAIL_OUTBOX_DIR. Both are valid for self-hosting with no provider.
EMAIL_PROVIDER=console
EMAIL_FROM=AIBA <no-reply@aiba.local>
# EMAIL_PROVIDER_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_OUTBOX_DIR=./data/mail-outbox

# ------------------------------------------------------------------- storage
# local | s3 | s3_compatible
# `local` writes generated assets to STORAGE_LOCAL_DIR and serves them through
# an authenticated route. No bucket or credentials needed.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
STORAGE_BUCKET=aiba-assets
STORAGE_REGION=us-east-1
# STORAGE_KEY=
# STORAGE_SECRET=
# STORAGE_ENDPOINT=                     # for S3-compatible providers (MinIO, R2…)
# STORAGE_PUBLIC_BASE_URL=

# ------------------------------------------------------------- notifications
# Optional outbound channels. Email (above), browser/in-app and webhooks always
# work; Telegram needs a bot token AND the chat id set per user in Settings.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# NOTIFY_WEBHOOK_URL=

# --------------------------------------------------------- research sources
# Only official APIs, permitted feeds and manual entries are ever consumed.
# These tokens simply raise rate limits and unlock extra sources.
# PRODUCTHUNT_TOKEN=
# GITHUB_TOKEN=
# NEWSAPI_KEY=
# Master switch for any outbound research request.
SOURCE_ALLOW_NETWORK=true
RESEARCH_USER_AGENT=AIBA-bot/1.0 (+https://your-domain.example/aiba)

# ------------------------------------------------------------------- runtime
# debug | info | warn | error | silent
LOG_LEVEL=info
SERVICE_VERSION=1.0.0

# Rate limiting (per IP, in-process or Redis-backed).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_API=240

# Demo data. When true, operators may generate sample rows; they are flagged and
# never mixed with real revenue. Set `false` on a real deployment.
DEMO_MODE_ENABLED=true

# Hard budget enforcement. Leave `true`: with `false` the per-action budget
# check is skipped and the platform ceiling stops being consulted.
BUDGET_ENFORCEMENT=true

# Platform-wide daily ceiling in cents (2000 = $20.00). Applies to every
# workspace and is the last line of defence if a user limit is misconfigured.
MAX_DAILY_AI_SPEND_CENTS=2000

# Worker heartbeat freshness before the dashboard reports DEGRADED.
HEARTBEAT_STALE_SECONDS=120
