# End-to-end test configuration.
#
# These values point AIBA at a local, OpenAI-compatible fixture server that the
# test itself starts on port 4599. It contains no real credentials and makes no
# third-party calls, which keeps the suite deterministic and offline-safe.
AI_PROVIDER=custom
AI_PROVIDER_KEY=fixture-key-not-a-real-credential
AI_BASE_URL=http://127.0.0.1:4599/v1
AI_MODEL=fixture-model
AI_ALLOW_NETWORK=true
SOURCE_ALLOW_NETWORK=true
E2E_USE_AI=true
E2E_AI_FIXTURE_PORT=4599
ENABLE_INLINE_JOBS=true
BUDGET_ENFORCEMENT=true
LOG_LEVEL=error
